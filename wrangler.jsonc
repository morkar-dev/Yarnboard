{
  // Cloudflare Workers static-assets deployment of the built frontend
  // only -- the API keeps running on Render (see README's "Deploying the
  // frontend to Cloudflare" section for the full setup, including the
  // Cloudflare-dashboard build command this repo can't configure itself,
  // and the VITE_API_BASE_URL / CORS_ORIGINS wiring needed for the two
  // separately-hosted origins to talk to each other).
  //
  // Without this file, `wrangler deploy` auto-detects settings and
  // defaults assets.directory to the raw "frontend" source folder
  // instead of its built "frontend/dist" output -- which serves
  // index.html referencing /src/main.tsx (a .tsx file browsers can't
  // execute) and renders a blank page. This file pins the real output
  // directory so that can't happen again.
  //
  // Two stages, two Render backends: this default (unnamed) config is
  // "prod" -- deployed from `main`, meant for the real custom domain, and
  // proxying to the prod API (yarnboard.onrender.com, built from `main`).
  // `env.dev` below is a second, separate Worker (own name, own
  // workers.dev URL) deployed from `dev` via a *separate* Cloudflare
  // project so a `dev` push can never overwrite the prod Worker; it
  // proxies to yarnboard-dev-api.onrender.com, the Render service built
  // from `dev`, so backend changes on `dev` are testable before `main`.
  "name": "yarnboard",
  "compatibility_date": "2026-09-09",
  // Proxies /api/* to the Render backend so the API is same-origin with
  // the page -- see worker/index.js for why (Safari/iOS drop the session
  // cookie when the API is on a different site).
  "main": "worker/index.js",
  "vars": {
    "API_ORIGIN": "https://yarnboard.onrender.com"
  },
  // Cloudflare's non-production branch builds run `wrangler preview`, which
  // refuses to start without its own vars. Previews are of unmerged
  // branches, so they get the dev API, never prod's.
  "previews": {
    "vars": {
      "API_ORIGIN": "https://yarnboard-dev-api.onrender.com"
    }
  },
  // Wrangler runs this itself before every deploy/preview/dev, so a
  // Cloudflare project with no dashboard build command (branch preview
  // builds included) still gets a frontend/dist. VITE_API_BASE_URL is
  // forced empty so a leftover dashboard build variable can't bake in the
  // Render URL and bypass the /api proxy (process env beats .env in Vite).
  "build": {
    "command": "cd frontend && npm install && VITE_API_BASE_URL= npm run build"
  },
  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS",
    // Everything but the built JS/CSS reaches the Worker script first: /api
    // is proxied, and app pages get per-URL language, canonical, hreflang
    // and preview tags (worker/index.js's servePage).
    "run_worker_first": ["/*", "!/assets/*"],
    // React Router (BrowserRouter, client-side routing) needs unmatched
    // paths like /pattern/5 to fall back to index.html rather than
    // 404ing on a direct load or page refresh.
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "env": {
    "dev": {
      // Distinct Worker name -> distinct workers.dev URL
      // (yarnboard-dev.<your-subdomain>.workers.dev), so this can never
      // collide with or overwrite the prod deployment above.
      "name": "yarnboard-dev",
      // `vars` isn't inherited by named environments -- set its own.
      "vars": {
        "API_ORIGIN": "https://yarnboard-dev-api.onrender.com"
      }
    }
  }
}
