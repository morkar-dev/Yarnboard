{
  "name": "yarnboard-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:dev": "playwright test --config=playwright.dev.config.ts",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --quiet",
    "test:stories": "vitest run --project=storybook",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "i18next": "^26.3.6",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-mcp": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/browser": "3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^29.1.1",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.3",
    "playwright": "1.63.0",
    "storybook": "10.6.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^3.2.7"
  }
}
